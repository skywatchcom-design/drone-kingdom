; Engine configuration file.

config_version=5

[application]

config/name="Drone Kingdom"
run/main_scene="res://scenes/merge/merge.tscn"
config/icon="res://assets/icon/icon.png"
boot_splash/bg_color=Color(0.094, 0.118, 0.071, 1)
boot_splash/image="res://assets/icon/splash.png"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Cloud="*res://scripts/autoload/cloud.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
